{
  "_about": "One list of quality-flag definitions shared by the Python core, the QGIS plugin and the Earth Engine script. A field is (start bit, number of bits). A flag is true where the field's value is in 'in'. Fields with bits [0, N] where N is the layer's bit depth are plain class values, not packed bits. Check 'source' before relying on a product.",
  "products": {
    "hls_fmask": {
      "title": "HLS v2.0 Fmask (HLSL30 and HLSS30)",
      "layer": "Fmask",
      "dtype": "uint8",
      "fill": [255],
      "filename_hints": ["HLS.L30.", "HLS.S30.", ".Fmask."],
      "source": "HLS v2.0 User Guide, Table 9; also the 'Fmask bit description' tag inside each Fmask file",
      "gee": {"collections": ["NASA/HLS/HLSL30/v002", "NASA/HLS/HLSS30/v002"], "band": "Fmask"},
      "fields": [
        {"name": "cirrus", "bits": [0, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "cloud", "bits": [1, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "adjacent", "bits": [2, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "shadow", "bits": [3, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "snow", "bits": [4, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "water", "bits": [5, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "aerosol", "bits": [6, 2], "values": {"0": "climatology", "1": "low", "2": "moderate", "3": "high"}}
      ],
      "flags": [
        {"name": "cirrus", "field": "cirrus", "in": [1], "label": "Cirrus (reserved; HLS v2.0 does not set it)"},
        {"name": "cloud", "field": "cloud", "in": [1], "label": "Cloud"},
        {"name": "adjacent", "field": "adjacent", "in": [1], "label": "Adjacent to cloud or shadow"},
        {"name": "shadow", "field": "shadow", "in": [1], "label": "Cloud shadow"},
        {"name": "snow", "field": "snow", "in": [1], "label": "Snow or ice"},
        {"name": "water", "field": "water", "in": [1], "label": "Water"},
        {"name": "aerosol_high", "field": "aerosol", "in": [3], "label": "High aerosol"},
        {"name": "aerosol_moderate", "field": "aerosol", "in": [2], "label": "Moderate aerosol"},
        {"name": "aerosol_climatology", "field": "aerosol", "in": [0], "label": "Aerosol from climatology (no retrieval)"}
      ],
      "presets": {
        "clear": ["cloud", "adjacent", "shadow", "snow", "aerosol_high"],
        "clear_land": ["cloud", "adjacent", "shadow", "snow", "aerosol_high", "water"],
        "strict": ["cloud", "adjacent", "shadow", "snow", "aerosol_high", "aerosol_moderate"],
        "cloud_only": ["cloud", "shadow"]
      },
      "default_preset": "clear"
    },
    "landsat_c2_qa_pixel": {
