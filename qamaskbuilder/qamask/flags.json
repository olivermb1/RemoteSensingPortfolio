        {"name": "land_water", "bits": [11, 3], "values": {"0": "shallow ocean", "1": "land", "2": "ocean coastlines and lake shorelines", "3": "shallow inland water", "4": "ephemeral water", "5": "deep inland water", "6": "moderate or continental ocean", "7": "deep ocean"}},
