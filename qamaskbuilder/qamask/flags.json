      "presets": {
        "clear": ["dilated_cloud", "cirrus", "cloud", "shadow", "snow"],
        "clear_land": ["dilated_cloud", "cirrus", "cloud", "shadow", "snow", "water"],
        "strict": ["dilated_cloud", "cirrus", "cloud", "shadow", "snow", "cloud_conf_medium", "cloud_conf_high"],
