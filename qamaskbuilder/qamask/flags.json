        {"name": "shadow_conf", "bits": [10, 2], "values": {"0": "none", "1": "low", "2": "reserved", "3": "high"}},
        {"name": "snow_conf", "bits": [12, 2], "values": {"0": "none", "1": "low", "2": "reserved", "3": "high"}},
