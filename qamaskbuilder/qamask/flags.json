        {"name": "not_land", "field": "land_water", "in": [0, 2, 3, 4, 5, 6, 7], "label": "Not land (any water class)"},
        {"name": "snow", "field": "snow_ice", "in": [1], "label": "Possible snow/ice"},
        {"name": "shadow", "field": "shadow", "in": [1], "label": "Possible shadow"}
      ],
      "presets": {
        "clear": ["probably_cloudy", "not_produced", "low_usefulness", "aerosol_high", "adjacent_cloud", "mixed_clouds", "snow", "shadow"],
