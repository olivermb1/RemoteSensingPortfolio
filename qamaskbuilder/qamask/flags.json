        {"name": "mandatory", "bits": [0, 2], "values": {"0": "good quality", "1": "other quality, check other QA", "2": "not produced, cloud", "3": "not produced, other"}},
        {"name": "data_quality", "bits": [2, 2], "values": {"0": "good", "1": "other quality", "2": "TBD", "3": "TBD"}},
        {"name": "emis_error", "bits": [4, 2], "values": {"0": "<= 0.01", "1": "<= 0.02", "2": "<= 0.04", "3": "> 0.04"}},
