        {"name": "adjacent", "bits": [13, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "salt_pan", "bits": [14, 1], "values": {"0": "no", "1": "yes"}},
        {"name": "internal_snow", "bits": [15, 1], "values": {"0": "no", "1": "yes"}}
      ],
      "flags": [
        {"name": "cloudy", "field": "cloud_state", "in": [1], "label": "Cloudy"},
        {"name": "mixed", "field": "cloud_state", "in": [2], "label": "Mixed cloud"},
        {"name": "shadow", "field": "shadow", "in": [1], "label": "Cloud shadow"},
        {"name": "not_land", "field": "land_water", "in": [0, 2, 3, 4, 5, 6, 7], "label": "Not land (any water class)"},
        {"name": "aerosol_high", "field": "aerosol", "in": [3], "label": "High aerosol"},
        {"name": "cirrus_average", "field": "cirrus", "in": [2], "label": "Average cirrus"},
        {"name": "cirrus_high", "field": "cirrus", "in": [3], "label": "High cirrus"},
        {"name": "internal_cloud", "field": "internal_cloud", "in": [1], "label": "Internal cloud algorithm flag"},
        {"name": "fire", "field": "internal_fire", "in": [1], "label": "Internal fire algorithm flag"},
        {"name": "snow", "field": "mod35_snow", "in": [1], "label": "MOD35 snow/ice"},
        {"name": "internal_snow", "field": "internal_snow", "in": [1], "label": "Internal snow mask"},
        {"name": "adjacent", "field": "adjacent", "in": [1], "label": "Adjacent to cloud"},
        {"name": "salt_pan", "field": "salt_pan", "in": [1], "label": "Salt pan"}
      ],
      "presets": {
        "clear": ["cloudy", "mixed", "shadow", "cirrus_high", "internal_cloud", "snow", "adjacent", "aerosol_high"],
        "clear_land": ["cloudy", "mixed", "shadow", "cirrus_high", "internal_cloud", "snow", "adjacent", "aerosol_high", "not_land"],
        "cloud_only": ["cloudy", "mixed", "shadow"]
      },
