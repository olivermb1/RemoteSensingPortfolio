    "modis_mod11_qc": {
      "title": "MODIS MOD11A1 / MOD11A2 land surface temperature QC_Day or QC_Night (Collection 6.1)",
      "layer": "QC_Day",
      "dtype": "uint8",
      "fill": [],
      "filename_hints": ["MOD11", "MYD11", "QC_Day", "QC_Night"],
