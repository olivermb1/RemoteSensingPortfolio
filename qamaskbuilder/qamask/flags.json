      ],
      "flags": [
        {"name": "dilated_cloud", "field": "dilated_cloud", "in": [1], "label": "Dilated cloud (buffer around cloud)"},
        {"name": "cirrus", "field": "cirrus", "in": [1], "label": "Cirrus (high confidence, Landsat 8/9)"},
        {"name": "cloud", "field": "cloud", "in": [1], "label": "Cloud"},
        {"name": "shadow", "field": "shadow", "in": [1], "label": "Cloud shadow"},
